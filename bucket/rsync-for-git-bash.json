{
  "version": "3.5.0",
  "description": "rsync optimized for Git for Windows (Git Bash) environment",
  "homepage": "https://github.com/bvarnai/rsync-for-git-bash",
  "license": "GPL-3.0-or-later",
  "url": "https://github.com/bvarnai/rsync-for-git-bash/releases/download/rsync-3.5.0-for-git-2.55.0.windows.5/rsync-3.5.0-for-git-2.55.0.windows.5-64-bit.zip",
  "hash": "55317e98ec308c025a78bd65009b65bb5cd722aa0cd0569f4086d73cdfdd5785",
  "post_install": [
    "New-Item -ItemType HardLink -Path \"$scoopdir\\shims\\rsync.exe\" -Target \"$dir\\bin\\rsync.exe\" -Force | Out-Null"
  ],
  "uninstaller": {
    "script": [
      "$shimPath = \"$scoopdir\\shims\\rsync.exe\"",
      "if (Test-Path $shimPath) {",
      "    Remove-Item $shimPath -Force",
      "}"
    ]
  },
  "checkver": "github",
  "autoupdate": {
    "url": "https://github.com/bvarnai/rsync-for-git-bash/releases/download/$tag/rsync-$version-for-git-$matchGit-64-bit.zip",
    "hash": {
      "url": "$url.sha256"
    }
  }
}
